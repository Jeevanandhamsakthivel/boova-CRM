# ── Flask ──
SECRET_KEY=change-me-to-a-random-secret
FLASK_ENV=development

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/psm_crm

# ── JWT ──
JWT_SECRET_KEY=change-me-to-a-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── SMTP (Email Delivery) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=PSM CRM
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=5
SMTP_TIMEOUT=30

# ── Email Webhook (Inbound) ──
EMAIL_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret
EXTERNAL_URL=http://localhost:5000

# ── AI Provider (Groq) ──
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── File Uploads ──
UPLOAD_FOLDER=uploads
